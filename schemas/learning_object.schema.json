{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://teachyourself.dev/schemas/learning_object.schema.json",
  "title": "LearningObject",
  "description": "Schema para objetos interativos de aprendizagem e simuladores",
  "type": "object",
  "required": ["id", "component_name", "visual_spec_ref", "target_concept", "interaction_mode"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LO-[0-9]{2}-[A-Z0-9_-]+$"
    },
    "component_name": {
      "type": "string"
    },
    "visual_spec_ref": {
      "type": "string"
    },
    "target_concept": {
      "type": "string"
    },
    "interaction_mode": {
      "type": "string",
      "enum": ["PREDICTION_STEPPER", "CONTINUOUS_SANDBOX", "PARSONS_PUZZLE", "INSPECTOR_DIAL"]
    },
    "default_state": {
      "type": "object"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "initial_values", "expected_outcome"],
        "properties": {
          "name": { "type": "string" },
          "initial_values": { "type": "object" },
          "expected_outcome": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
