---
interface Props {
  title: string;
  date: string;
  system: string;
  impact: string;
}

const { title, date, system, impact } = Astro.props;
---

<div class="my-8 rounded-card border border-ash bg-white p-6 md:p-8 text-graphite shadow-sm transition-all">
  {/* Header do Relatório Histórico */}
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ash pb-4 mb-5">
    <div class="flex items-center gap-3">
      <span class="rounded-full bg-coral/15 p-2 text-crimson border border-coral/30">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
      </span>
      <div>
        <div class="text-[11px] uppercase tracking-wider font-mono text-smoke">
          Incidente Crítico de Engenharia
        </div>
        <div class="font-serif text-xl font-normal text-off-black tracking-tight mt-0.5">{title}</div>
      </div>
    </div>

    <div class="flex items-center gap-2 text-xs font-mono text-smoke">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-ash bg-parchment px-3 py-1">
        <svg class="h-3 w-3 text-lake-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        {date}
      </span>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-ash bg-parchment px-3 py-1">
        <svg class="h-3 w-3 text-graphite" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="4" width="16" height="16" rx="2" />
          <rect x="9" y="9" width="6" height="6" />
          <line x1="9" y1="1" x2="9" y2="4" />
          <line x1="15" y1="1" x2="15" y2="4" />
          <line x1="9" y1="20" x2="9" y2="23" />
          <line x1="15" y1="20" x2="15" y2="23" />
          <line x1="20" y1="9" x2="23" y2="9" />
          <line x1="20" y1="15" x2="23" y2="15" />
          <line x1="1" y1="9" x2="4" y2="9" />
          <line x1="1" y1="15" x2="4" y2="15" />
        </svg>
        {system}
      </span>
    </div>
  </div>

  {/* Conteúdo da Narrativa Histórica */}
  <div class="space-y-3 font-mono text-xs md:text-sm leading-relaxed text-graphite">
    <slot />
  </div>

  {/* Footer com Impacto de Engenharia */}
  <div class="mt-5 pt-4 border-t border-ash flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
    <span class="text-smoke uppercase text-[11px] tracking-wider">Impacto no Sistema:</span>
    <span class="inline-flex items-center rounded-full bg-coral/15 border border-coral/30 px-3.5 py-1 text-crimson font-medium text-xs">
      {impact}
    </span>
  </div>
</div>
