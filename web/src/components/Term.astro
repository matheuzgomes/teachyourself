---
import { glossary } from '../data/glossary';

interface Props {
  id: string;
}

const { id } = Astro.props;
const info = glossary[id] || {
  abbr: id,
  fullName: id,
  category: 'Hardware',
  location: 'Componente de Arquitetura',
  description: 'Termo técnico fundamental de computação.',
};
---

<span class="relative inline-block group align-baseline">
  <span
    tabindex="0"
    role="button"
    aria-label={info.fullName}
    class="inline-flex items-center border-b border-dashed border-lake-blue text-lake-blue font-medium hover:border-off-black hover:text-off-black transition-colors cursor-help px-0.5 rounded focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-lake-blue"
  >
    <slot>{id}</slot>
  </span>

  {/* Tooltip Card Flutuante via CSS puro (Funciona 100% sem JavaScript).
      Fechado sai do layout com display:none (invisible ainda criava rolagem
      horizontal). No mobile vira lâmina fixa com margens (sempre cabe na
      viewport); no desktop mantém a ancoragem acima do termo. */}
  <span
    class="hidden group-hover:block group-focus-within:block z-50 rounded-card border border-ash bg-white p-4 shadow-xl pointer-events-none group-hover:pointer-events-auto text-left font-sans normal-case not-italic font-normal text-off-black max-sm:fixed max-sm:left-2 max-sm:right-2 max-sm:bottom-2 max-sm:top-auto max-sm:w-auto max-sm:translate-x-0 max-sm:mb-0 sm:absolute sm:bottom-full sm:left-1/2 sm:-translate-x-1/2 sm:mb-2 sm:w-80 w-72"
  >
    {/* Header do Card */}
    <span class="flex items-start justify-between gap-2 border-b border-ash/70 pb-2.5 mb-2.5 block">
      <span class="font-serif text-sm font-normal text-off-black leading-tight block">
        {info.fullName}
      </span>
      <span class="rounded-full bg-[#2b59d1]/10 px-2.5 py-0.5 text-[10px] font-mono font-bold text-lake-blue border border-lake-blue/20 whitespace-nowrap block">
        {info.category}
      </span>
    </span>

    {/* Onde fica */}
    <span class="flex items-center gap-1.5 text-[11px] text-graphite mb-2 font-mono block">
      <svg class="h-3.5 w-3.5 text-lake-blue shrink-0 inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
        <circle cx="12" cy="10" r="3" />
      </svg>
      <span class="truncate">{info.location}</span>
    </span>

    {/* Descricao Didatica */}
    <span class="text-xs text-graphite leading-relaxed block font-sans">
      {info.description}
    </span>

    {/* Seta do Tooltip (só no desktop ancorado; no mobile vira lâmina inferior) */}
    <span class="absolute top-full left-1/2 -translate-x-1/2 -mt-px border-4 border-transparent border-t-ash max-sm:hidden block"></span>
    <span class="absolute top-full left-1/2 -translate-x-1/2 -mt-[2px] border-4 border-transparent border-t-white max-sm:hidden block"></span>
  </span>
</span>
