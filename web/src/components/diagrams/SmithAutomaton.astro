---
import DiagramFrame from './DiagramFrame.astro';

const states = [
  { id: 's00', x: 70, label: '00', sub: 'Strongly', pred: 'Não-Tomado' },
  { id: 's01', x: 250, label: '01', sub: 'Weakly', pred: 'Não-Tomado' },
  { id: 's10', x: 430, label: '10', sub: 'Weakly', pred: 'Tomado' },
  { id: 's11', x: 610, label: '11', sub: 'Strongly', pred: 'Tomado' },
];
---

<DiagramFrame
  eyebrow="Branch prediction"
  title="O Autômato de Smith com Histerese"
  subtitle="Quatro estados em dois hemisférios. Duas decisões contrárias seguidas para virar a recomendação."
  steps={[
    '<strong>Passo 1:</strong> divida os estados em hemisférios: 00 e 01 preveem Não-Tomado, 10 e 11 preveem Tomado.',
    '<strong>Passo 2:</strong> siga as setas cheias (Tomado) para a direita e as tracejadas (Não-Tomado) para a esquerda, um estado por decisão.',
    '<strong>Passo 3:</strong> parta de 11 e aplique um Não-Tomado isolado: o autômato cai para 10 e mantém a recomendação. Essa é a histerese.',
  ]}
  conclusion="A histerese impede que uma única saída de laço reverta a predição: é preciso errar duas vezes seguidas para cruzar de hemisfério. O laço aquecido erra só na saída, nunca na reentrada."
>
  <svg viewBox="0 0 680 310" class="w-full h-auto font-mono select-none" role="img" aria-label="Autômato de 4 estados: 00 e 01 preveem não-tomado, 10 e 11 preveem tomado, com transições por decisão real">
    <title>Contador saturante de 2 bits de Smith</title>
    {/* Divisão dos Hemisférios */}
    <line x1="40" y1="265" x2="640" y2="265" stroke="currentColor" stroke-opacity="0.25" />
    <line x1="340" y1="255" x2="340" y2="275" stroke="currentColor" stroke-opacity="0.4" />
    <text x="160" y="288" text-anchor="middle" font-size="12" font-weight="bold" class="fill-graphite">Hemisfério Não-Tomado (00, 01)</text>
    <text x="520" y="288" text-anchor="middle" font-size="12" font-weight="bold" class="fill-lake-blue">Hemisfério Tomado (10, 11)</text>

    {states.map((s) => (
      <g>
        <rect x={s.x - 60} y="85" width="120" height="90" rx="14" fill={s.pred === 'Tomado' ? '#2b59d1' : '#ffffff'} fill-opacity={s.pred === 'Tomado' ? '0.1' : '1'} stroke={s.pred === 'Tomado' ? '#2b59d1' : '#6b7280'} stroke-width="2" />
        <text x={s.x} y="117" text-anchor="middle" font-size="22" font-weight="bold" class="fill-off-black">{s.label}</text>
        <text x={s.x} y="138" text-anchor="middle" font-size="12" class="fill-graphite">{s.sub}</text>
        <text x={s.x} y="156" text-anchor="middle" font-size="12" font-weight="bold" class={s.pred === 'Tomado' ? 'fill-lake-blue' : 'fill-off-black'}>{s.pred}</text>
      </g>
    ))}

    <g font-size="11" class="fill-graphite">
      {/* Transições entre Estados */}
      <line x1="130" y1="115" x2="185" y2="115" stroke="#2b59d1" stroke-width="2" marker-end="url(#ah)" />
      <text x="132" y="107">Tomado</text>
      <line x1="185" y1="145" x2="130" y2="145" stroke="#6b7280" stroke-width="2" stroke-dasharray="5 4" marker-end="url(#ah)" />
      <text x="132" y="163">Não-Tom.</text>

      <line x1="310" y1="115" x2="365" y2="115" stroke="#2b59d1" stroke-width="2" marker-end="url(#ah)" />
      <text x="312" y="107">Tomado</text>
      <line x1="365" y1="145" x2="310" y2="145" stroke="#6b7280" stroke-width="2" stroke-dasharray="5 4" marker-end="url(#ah)" />
      <text x="312" y="163">Não-Tom.</text>

      <line x1="490" y1="115" x2="545" y2="115" stroke="#2b59d1" stroke-width="2" marker-end="url(#ah)" />
      <text x="492" y="107">Tomado</text>
      <line x1="545" y1="145" x2="490" y2="145" stroke="#6b7280" stroke-width="2" stroke-dasharray="5 4" marker-end="url(#ah)" />
      <text x="492" y="163">Não-Tom.</text>

      {/* Auto-loops Saturantes nas Extremidades */}
      <path d="M 45 175 C 30 215, 95 215, 85 178" fill="none" stroke="#6b7280" stroke-width="2" stroke-dasharray="5 4" marker-end="url(#ah)" />
      <text x="65" y="235" text-anchor="middle" font-size="10">Não-Tom. (00 &rarr; 00)</text>

      <path d="M 585 175 C 570 215, 635 215, 625 178" fill="none" stroke="#2b59d1" stroke-width="2" marker-end="url(#ah)" />
      <text x="605" y="235" text-anchor="middle" font-size="10" class="fill-lake-blue font-bold">Tomado (11 &rarr; 11)</text>
    </g>
    <defs>
      <marker id="ah" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8" fill="none" stroke="#6b7280" stroke-width="1.5" />
      </marker>
    </defs>
  </svg>
</DiagramFrame>
