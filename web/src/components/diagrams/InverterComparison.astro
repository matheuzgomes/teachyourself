---
import DiagramFrame from './DiagramFrame.astro';
---

<DiagramFrame
  eyebrow="Uma entrada, saída garantida"
  title="Entrada em 0 entrega 1, entrada em 1 entrega 0"
  subtitle="Duas chaves empilhadas entre o + e o − : a saída sai do ponto entre elas e fica sempre ligada a um dos trilhos."
  steps={[
    '<strong>Passo 1:</strong> localize o trilho + em cima, o trilho − (retorno) embaixo e a saída no ponto entre as chaves.',
    '<strong>Passo 2:</strong> acompanhe o fio de entrada que comanda as duas chaves ao mesmo tempo.',
    '<strong>Passo 3:</strong> confira qual chave está fechada em cada caso e a qual trilho a saída fica ligada.',
  ]}
  conclusion="Em cada repouso uma chave conduz e a outra bloqueia, então a saída fica sempre ligada ao + ou ao − , nunca solta."
>
  <div class="my-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    <figure class="rounded-2xl border border-ash bg-parchment p-4">
      <figcaption class="font-mono text-xs font-bold uppercase tracking-wider text-graphite">
        Entrada 0 <span aria-hidden="true">→</span> saída 1
      </figcaption>
      <svg viewBox="0 0 340 270" class="mt-3 h-auto w-full select-none font-mono" role="img" aria-label="Entrada em 0: chave de cima fechada liga a saída ao mais, saída em 1">
        <line x1="110" y1="28" x2="230" y2="28" stroke="#242424" stroke-width="3" />
        <text x="170" y="20" font-size="12" font-weight="bold" fill="#242424" text-anchor="middle">+ (alto)</text>
        <line x1="170" y1="28" x2="170" y2="52" stroke="#2b59d1" stroke-width="2.5" />
        <rect x="135" y="52" width="70" height="48" rx="6" fill="#2b59d1" stroke="#242424" stroke-width="1.5" />
        <text x="170" y="72" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">de cima</text>
        <text x="170" y="88" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">fechada ✓</text>
        <line x1="170" y1="100" x2="170" y2="128" stroke="#2b59d1" stroke-width="2.5" />
        <circle cx="170" cy="128" r="5" fill="#242424" />
        <line x1="170" y1="128" x2="252" y2="128" stroke="#2b59d1" stroke-width="2.5" />
        <text x="296" y="124" font-size="13" font-weight="bold" fill="#2b59d1" text-anchor="middle">saída 1</text>
        <text x="296" y="140" font-size="11" fill="#2b59d1" text-anchor="middle">ligada ao +</text>
        <line x1="170" y1="128" x2="170" y2="158" stroke="#615e5d" stroke-width="2" />
        <rect x="135" y="158" width="70" height="48" rx="6" fill="#f6f3f1" stroke="#615e5d" stroke-width="1.5" />
        <text x="170" y="178" font-size="11" font-weight="bold" fill="#615e5d" text-anchor="middle">de baixo</text>
        <text x="170" y="194" font-size="11" font-weight="bold" fill="#615e5d" text-anchor="middle">aberta ×</text>
        <line x1="170" y1="206" x2="170" y2="232" stroke="#615e5d" stroke-width="2" />
        <line x1="110" y1="232" x2="230" y2="232" stroke="#242424" stroke-width="3" />
        <text x="170" y="250" font-size="12" font-weight="bold" fill="#242424" text-anchor="middle">− (retorno)</text>
        <line x1="30" y1="128" x2="60" y2="128" stroke="#615e5d" stroke-width="2" />
        <circle cx="60" cy="128" r="4" fill="#615e5d" />
        <line x1="60" y1="128" x2="60" y2="76" stroke="#615e5d" stroke-width="2" stroke-dasharray="5 4" />
        <line x1="60" y1="76" x2="135" y2="76" stroke="#615e5d" stroke-width="2" stroke-dasharray="5 4" />
        <line x1="60" y1="128" x2="60" y2="182" stroke="#615e5d" stroke-width="2" stroke-dasharray="5 4" />
        <line x1="60" y1="182" x2="135" y2="182" stroke="#615e5d" stroke-width="2" stroke-dasharray="5 4" />
        <text x="38" y="112" font-size="12" font-weight="bold" fill="#242424" text-anchor="middle">entrada 0</text>
      </svg>
    </figure>
    <figure class="rounded-2xl border border-ash bg-parchment p-4">
      <figcaption class="font-mono text-xs font-bold uppercase tracking-wider text-graphite">
        Entrada 1 <span aria-hidden="true">→</span> saída 0
      </figcaption>
      <svg viewBox="0 0 340 270" class="mt-3 h-auto w-full select-none font-mono" role="img" aria-label="Entrada em 1: chave de baixo fechada liga a saída ao menos, saída em 0">
        <line x1="110" y1="28" x2="230" y2="28" stroke="#242424" stroke-width="3" />
        <text x="170" y="20" font-size="12" font-weight="bold" fill="#242424" text-anchor="middle">+ (alto)</text>
        <line x1="170" y1="28" x2="170" y2="52" stroke="#615e5d" stroke-width="2" />
        <rect x="135" y="52" width="70" height="48" rx="6" fill="#f6f3f1" stroke="#615e5d" stroke-width="1.5" />
        <text x="170" y="72" font-size="11" font-weight="bold" fill="#615e5d" text-anchor="middle">de cima</text>
        <text x="170" y="88" font-size="11" font-weight="bold" fill="#615e5d" text-anchor="middle">aberta ×</text>
        <line x1="170" y1="100" x2="170" y2="128" stroke="#615e5d" stroke-width="2" />
        <circle cx="170" cy="128" r="5" fill="#242424" />
        <line x1="170" y1="128" x2="252" y2="128" stroke="#615e5d" stroke-width="2" />
        <text x="296" y="124" font-size="13" font-weight="bold" fill="#242424" text-anchor="middle">saída 0</text>
        <text x="296" y="140" font-size="11" fill="#615e5d" text-anchor="middle">ligada ao −</text>
        <line x1="170" y1="128" x2="170" y2="158" stroke="#2b59d1" stroke-width="2.5" />
        <rect x="135" y="158" width="70" height="48" rx="6" fill="#2b59d1" stroke="#242424" stroke-width="1.5" />
        <text x="170" y="178" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">de baixo</text>
        <text x="170" y="194" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">fechada ✓</text>
        <line x1="170" y1="206" x2="170" y2="232" stroke="#2b59d1" stroke-width="2.5" />
        <line x1="110" y1="232" x2="230" y2="232" stroke="#242424" stroke-width="3" />
        <text x="170" y="250" font-size="12" font-weight="bold" fill="#242424" text-anchor="middle">− (retorno)</text>
        <line x1="30" y1="128" x2="60" y2="128" stroke="#2b59d1" stroke-width="2.5" />
        <circle cx="60" cy="128" r="4" fill="#2b59d1" />
        <line x1="60" y1="128" x2="60" y2="76" stroke="#2b59d1" stroke-width="2.5" stroke-dasharray="5 4" />
        <line x1="60" y1="76" x2="135" y2="76" stroke="#2b59d1" stroke-width="2.5" stroke-dasharray="5 4" />
        <line x1="60" y1="128" x2="60" y2="182" stroke="#2b59d1" stroke-width="2.5" stroke-dasharray="5 4" />
        <line x1="60" y1="182" x2="135" y2="182" stroke="#2b59d1" stroke-width="2.5" stroke-dasharray="5 4" />
        <text x="38" y="112" font-size="12" font-weight="bold" fill="#2b59d1" text-anchor="middle">entrada 1</text>
      </svg>
    </figure>
  </div>
</DiagramFrame>
