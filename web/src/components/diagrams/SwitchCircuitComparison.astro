---
import DiagramFrame from './DiagramFrame.astro';
---

<DiagramFrame
  eyebrow="Dois estados, um laço"
  title="Chave aberta apaga, chave fechada acende"
  subtitle="O mesmo laço nos dois casos: pilha, chave e lâmpada em série, com ida e retorno só através da lâmpada."
  steps={[
    '<strong>Passo 1:</strong> localize os dois terminais da pilha: + em cima e − (retorno) embaixo.',
    '<strong>Passo 2:</strong> siga o fio de ida do + até a chave, o ponto P depois dela e o terminal A da lâmpada.',
    '<strong>Passo 3:</strong> saia pelo terminal B da lâmpada e desça pelo retorno até o − : o laço só fecha pela lâmpada.',
  ]}
  conclusion="A posição da chave decide se o laço existe. Laço fechado, lâmpada acesa; laço interrompido na chave, lâmpada apagada."
>
  <div class="my-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    <figure class="rounded-2xl border border-ash bg-parchment p-4">
      <figcaption class="font-mono text-xs font-bold uppercase tracking-wider text-graphite">
        Caso aberto <span aria-hidden="true">×</span> lâmpada apagada
      </figcaption>
      <svg viewBox="0 0 360 250" class="mt-3 h-auto w-full select-none font-mono" role="img" aria-label="Laço aberto: a chave aberta interrompe o laço e a lâmpada de dois terminais fica apagada">
        <rect x="26" y="96" width="30" height="64" rx="6" fill="#ffffff" stroke="#242424" stroke-width="1.5" />
        <text x="41" y="124" font-size="12" font-weight="bold" fill="#242424" text-anchor="middle">pilha</text>
        <circle cx="41" cy="96" r="4" fill="#242424" />
        <text x="18" y="100" font-size="13" font-weight="bold" fill="#242424" text-anchor="middle">+</text>
        <circle cx="41" cy="160" r="4" fill="#242424" />
        <text x="18" y="164" font-size="13" font-weight="bold" fill="#242424" text-anchor="middle">−</text>
        <line x1="41" y1="96" x2="118" y2="96" stroke="#615e5d" stroke-width="2" />
        <line x1="118" y1="96" x2="168" y2="68" stroke="#b3202c" stroke-width="2.5" />
        <circle cx="118" cy="96" r="3.5" fill="#242424" />
        <circle cx="178" cy="96" r="3.5" fill="#242424" />
        <text x="143" y="52" font-size="12" font-weight="bold" fill="#b3202c" text-anchor="middle">chave aberta ×</text>
        <line x1="178" y1="96" x2="232" y2="96" stroke="#615e5d" stroke-width="2" />
        <polygon points="205,90 211,96 205,102 199,96" fill="none" stroke="#242424" stroke-width="1.5" />
        <text x="205" y="82" font-size="11" fill="#242424" text-anchor="middle">ponto P</text>
        <circle cx="232" cy="96" r="4" fill="#242424" />
        <text x="232" y="114" font-size="11" fill="#242424" text-anchor="middle">A</text>
        <circle cx="258" cy="96" r="24" fill="#f6f3f1" stroke="#615e5d" stroke-width="1.5" />
        <circle cx="284" cy="96" r="4" fill="#242424" />
        <text x="284" y="114" font-size="11" fill="#242424" text-anchor="middle">B</text>
        <line x1="284" y1="96" x2="318" y2="96" stroke="#615e5d" stroke-width="2" />
        <line x1="318" y1="96" x2="318" y2="160" stroke="#615e5d" stroke-width="2" />
        <line x1="318" y1="160" x2="41" y2="160" stroke="#615e5d" stroke-width="2" />
        <text x="258" y="60" font-size="12" fill="#615e5d" text-anchor="middle">lâmpada apagada</text>
        <text x="180" y="178" font-size="11" fill="#615e5d" text-anchor="middle">retorno ao −</text>
        <text x="180" y="206" font-size="12" fill="#615e5d" text-anchor="middle">laço interrompido na chave</text>
      </svg>
    </figure>
    <figure class="rounded-2xl border border-ash bg-parchment p-4">
      <figcaption class="font-mono text-xs font-bold uppercase tracking-wider text-graphite">
        Caso fechado <span aria-hidden="true">✓</span> lâmpada acesa
      </figcaption>
      <svg viewBox="0 0 360 250" class="mt-3 h-auto w-full select-none font-mono" role="img" aria-label="Laço fechado: a chave fechada completa o laço através da lâmpada e ela acende">
        <rect x="26" y="96" width="30" height="64" rx="6" fill="#ffffff" stroke="#242424" stroke-width="1.5" />
        <text x="41" y="124" font-size="12" font-weight="bold" fill="#242424" text-anchor="middle">pilha</text>
        <circle cx="41" cy="96" r="4" fill="#2b59d1" />
        <text x="18" y="100" font-size="13" font-weight="bold" fill="#242424" text-anchor="middle">+</text>
        <circle cx="41" cy="160" r="4" fill="#2b59d1" />
        <text x="18" y="164" font-size="13" font-weight="bold" fill="#242424" text-anchor="middle">−</text>
        <line x1="41" y1="96" x2="178" y2="96" stroke="#2b59d1" stroke-width="2.5" />
        <circle cx="118" cy="96" r="3.5" fill="#2b59d1" />
        <circle cx="178" cy="96" r="3.5" fill="#2b59d1" />
        <text x="143" y="82" font-size="12" font-weight="bold" fill="#0e7c54" text-anchor="middle">chave fechada ✓</text>
        <line x1="178" y1="96" x2="232" y2="96" stroke="#2b59d1" stroke-width="2.5" />
        <polygon points="205,90 211,96 205,102 199,96" fill="#2b59d1" stroke="none" />
        <text x="205" y="82" font-size="11" font-weight="bold" fill="#242424" text-anchor="middle">ponto P</text>
        <circle cx="232" cy="96" r="4" fill="#2b59d1" />
        <text x="232" y="114" font-size="11" fill="#242424" text-anchor="middle">A</text>
        <circle cx="258" cy="96" r="24" fill="#fdf3d7" stroke="#0e7c54" stroke-width="2" />
        <circle cx="284" cy="96" r="4" fill="#2b59d1" />
        <text x="284" y="114" font-size="11" fill="#242424" text-anchor="middle">B</text>
        <line x1="284" y1="96" x2="318" y2="96" stroke="#2b59d1" stroke-width="2.5" />
        <line x1="318" y1="96" x2="318" y2="160" stroke="#2b59d1" stroke-width="2.5" />
        <line x1="318" y1="160" x2="41" y2="160" stroke="#2b59d1" stroke-width="2.5" />
        <text x="258" y="60" font-size="12" font-weight="bold" fill="#0e7c54" text-anchor="middle">lâmpada acesa</text>
        <text x="180" y="178" font-size="11" fill="#0e7c54" text-anchor="middle">retorno ao −</text>
        <text x="180" y="206" font-size="12" font-weight="bold" fill="#0e7c54" text-anchor="middle">laço fechado só pela lâmpada</text>
      </svg>
    </figure>
  </div>
</DiagramFrame>
