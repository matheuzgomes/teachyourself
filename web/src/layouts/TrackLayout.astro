---
import '../styles/global.css';
import { HugeiconsIcon } from '@hugeicons/react';
import { CpuIcon, NetworkIcon, DatabaseIcon, ServerIcon, GitBranchIcon } from '@hugeicons/core-free-icons';

interface Props {
  title?: string;
  description?: string;
  trackId?: string;
  trackTitle?: string;
  headings?: { depth: number; slug: string; text: string }[];
  frontmatter?: {
    title?: string;
    description?: string;
    trackId?: string;
    trackTitle?: string;
    headings?: { depth: number; slug: string; text: string }[];
  };
}

const props = Astro.props.frontmatter || Astro.props;
const title = props.title;
const description = props.description;
const trackId = (props.trackId || '') as string;
const trackTitle = (props.trackTitle || '') as string;
const headings = Astro.props.headings || props.headings;

const isOverview = trackId === 'overview';

const tracks = [
  { id: 'hardware-and-os', path: '/tracks/01-hardware-and-os', title: 'Sistemas de Computação', icon: CpuIcon, active: trackId.includes('hardware-and-os'), count: '9 Módulos Ativos' },
  { id: 'networks', path: '#', title: 'Redes e Comunicação de Dados', icon: NetworkIcon, active: trackId.includes('networks'), count: 'Em desenvolvimento' },
  { id: 'databases', path: '#', title: 'Bancos de Dados & Storage Engines', icon: DatabaseIcon, active: trackId.includes('databases'), count: 'Em desenvolvimento' },
  { id: 'distributed-systems', path: '#', title: 'Sistemas Distribuídos & Consenso', icon: ServerIcon, active: trackId.includes('distributed-systems'), count: 'Em desenvolvimento' },
  { id: 'algorithms-and-design', path: '#', title: 'Algoritmos & Design de Software', icon: GitBranchIcon, active: trackId.includes('algorithms-and-design'), count: 'Em desenvolvimento' },
];
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth scroll-pt-24 bg-parchment text-off-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | TeachYourself</title>
    <meta name="description" content={description || 'Periódico técnico editorial sobre fundamentos de computação.'} />
  </head>
  <body class="bg-parchment text-off-black min-h-screen flex flex-col font-sans antialiased">
    {/* Link acessível de salto para conteúdo (WCAG 2.4.1) */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-off-black focus:text-white focus:rounded-full focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-lake-blue focus:font-mono focus:text-xs"
    >
      Pular para o conteúdo principal
