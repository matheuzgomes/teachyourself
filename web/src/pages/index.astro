---
import TrackLayout from '../layouts/TrackLayout.astro';
import RetroComputer3D from '../components/retro-3d/RetroComputer3D';
import StudySearch from '../components/StudySearch.astro';
import ContinueReading from '../components/ContinueReading.astro';
import { withBase } from '../utils/paths';
import {
  curriculum,
  getActiveTracks,
  getModulesByTrack,
  getPlannedTracks,
  getPrimarySourceForModule,
  moduleHref,
} from '../data/curriculum';

const hardwareModules = getModulesByTrack('01-hardware-and-os');
const networkModules = getModulesByTrack('02-networks');
const plannedTracks = getPlannedTracks();
const activeTracks = getActiveTracks();
const initialQuery = Astro.url.searchParams.get('q') || '';

const searchEntries = curriculum.study_index.map((item) => {
  const mod = hardwareModules.concat(networkModules).find((m) => m.slug === item.slug);
  return {
    id: item.id,
    question: item.question,
    terms: item.terms,
    track: item.track,
    slug: item.slug,
    href: item.href,
    moduleTitle: mod ? mod.title : item.slug,
    moduleDescription: mod ? mod.description : '',
    pilot: mod?.study_state === 'pilot',
  };
});

const resumeModules = hardwareModules.concat(networkModules).map((m) => ({
  track: m.track,
  slug: m.slug,
  title: m.title,
}));

const pilotSources = curriculum.sources.filter((s) => s.role === 'primary');
const supportSources = curriculum.sources.filter((s) => s.role === 'supporting');
---

<TrackLayout
  title="TeachYourself : Do Bit ao Kernel para quem já programa"
  trackId="overview"
  trackTitle="Visão Geral do Currículo"
>
  <div class="space-y-20 md:space-y-28">
    <section class="relative pt-6 md:pt-12 pb-8 text-center max-w-5xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-ash bg-white/80 px-4 py-1.5 text-xs font-mono uppercase tracking-wider text-graphite mb-8 shadow-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-lake-blue" />
        <span>Roteiro piloto: módulos 00 e 01</span>
      </div>

      <h1 class="font-serif text-[clamp(2rem,5vw,3rem)] font-normal leading-[1.2] tracking-[-0.02em] text-off-black [text-wrap:balance]">
        Computação em baixo nível com rigor mecânico e empírico.
      </h1>

      <p class="font-sans text-base md:text-lg text-graphite leading-relaxed max-w-3xl mx-auto mt-8 tracking-[-0.01em] [text-wrap:pretty]">
        Um roteiro de estudo para quem já programa e quer entender o que acontece
        de verdade dentro da máquina: do transistor ao clock, do bit ao ponto flutuante.
        Cada objetivo é atingível só com leitura e simuladores na página.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={withBase(moduleHref(hardwareModules[0]))}
          class="inline-flex items-center gap-2.5 rounded-full bg-off-black px-8 py-4 min-h-[48px] text-sm font-mono uppercase tracking-wider text-white hover:bg-black active:scale-[0.98] transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-off-black focus-visible:ring-offset-2 focus-visible:ring-offset-parchment"
        >
          Começar a estudar
        </a>

        <a
          href="#encontrar-mecanismo"
          class="inline-flex items-center gap-2 rounded-full border border-ash bg-white/70 hover:bg-white active:scale-[0.98] px-7 py-4 min-h-[48px] text-sm font-mono uppercase tracking-wider text-off-black hover:border-off-black transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-off-black focus-visible:ring-offset-2 focus-visible:ring-offset-parchment"
        >
          Encontrar um mecanismo
        </a>
      </div>
    </section>

    <section id="para-quem-e" aria-labelledby="para-quem-titulo" class="scroll-mt-24 grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="rounded-card border border-ash bg-white p-8 md:p-10 shadow-sm">
        <span class="font-mono text-xs uppercase tracking-widest text-smoke">Para quem é</span>
        <h2 id="para-quem-titulo" class="mt-1 border-0 pb-0">Experiência com software, do estágio ao sênior</h2>
        <p>
          {curriculum.audience.profile} O ponto de partida é a leitura atenta:
          acompanhar circuitos descritos no texto e simuladores na página.
        </p>
        <p>
          Não se assume programação prévia, representação binária, organização
          de memória e registradores, chamadas de sistema ou concorrência em
          hardware. Esses são os destinos do roteiro, não os pré-requisitos.
        </p>
      </div>
      <div class="rounded-card border border-ash bg-white p-8 md:p-10 shadow-sm">
        <span class="font-mono text-xs uppercase tracking-widest text-smoke">O que esperar</span>
        <h2 class="mt-1 border-0 pb-0">Leitura guiada, terminal opcional</h2>
        <ul class="my-5 space-y-2">
          <li>Todo objetivo obrigatório se cumpre só com a leitura e os simuladores da página.</li>
          <li>Terminal e comandos de inspeção são opcionais: {curriculum.audience.terminal_note}</li>
          <li>Aprofundamentos ficam em blocos dobráveis. Abrir ou não, o caminho principal continua completo.</li>
          <li>Posição de leitura fica guardada só neste navegador. Leitura concluída não equivale a domínio.</li>
        </ul>
      </div>
    </section>

    <ContinueReading modules={resumeModules} currentPath={null} />

    <StudySearch entries={searchEntries} initialQuery={initialQuery} />

    <section id="grade-curricular" class="space-y-8 scroll-mt-10">
      <div>
        <span class="font-mono text-xs uppercase tracking-widest text-graphite">
          Grade Curricular
        </span>
        <h2 class="font-serif text-[clamp(1.5rem,3.5vw,2.25rem)] font-normal leading-[1.25] text-off-black tracking-[-0.02em] mt-1 border-0 pb-0 [text-wrap:balance]">
          Trilhas de estudo
        </h2>
        <p class="max-w-[70ch]">
          O roteiro piloto cobre os módulos 00 e 01 da Trilha 01. Os demais módulos
          têm página publicada, mas o conteúdo ainda não passou por revisão neste percurso.
        </p>
      </div>

      <div class="space-y-6">
        {activeTracks.map((track) => {
          const mods = getModulesByTrack(track.id);
          const pilots = mods.filter((m) => m.study_state === 'pilot');
          return (
            <article class="relative overflow-hidden rounded-card border border-ash bg-periwinkle-mist p-8 md:p-12 shadow-sm">
              <div class="space-y-5">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="rounded-full bg-white border border-ash px-3.5 py-1 text-xs font-mono uppercase tracking-wider text-off-black font-medium">
                    {track.title}
                  </span>
                  <span class="rounded-full bg-white/70 border border-ash px-3 py-1 text-xs font-mono text-graphite">
                    {mods.length === 1 ? '1 módulo' : `${mods.length} módulos`}
                    {pilots.length > 0 ? ` · roteiro piloto em ${pilots.length}` : ''}
                  </span>
                </div>

                <p class="font-sans text-base text-graphite leading-relaxed tracking-[-0.01em] [text-wrap:pretty] max-w-[80ch]">
                  {track.description}
                </p>

                <ul class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                  {mods.map((m) => (
                    <li>
                      <a
                        href={withBase(moduleHref(m))}
                        class="flex min-h-[44px] items-center justify-between gap-3 rounded-2xl border border-ash bg-white/90 px-4 py-3 transition-all hover:border-lake-blue/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lake-blue"
                      >
                        <span class="font-sans text-sm text-off-black leading-snug">{m.title}</span>
                        {m.study_state === 'pilot' ? (
                          <span class="shrink-0 rounded-full bg-lake-blue px-2.5 py-0.5 font-mono text-xs text-white">Piloto</span>
                        ) : (
                          <span class="shrink-0 rounded-full border border-ash bg-parchment px-2.5 py-0.5 font-mono text-xs text-smoke">Sem revisão</span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>

                <div class="pt-1">
                  {track.catalog_href && (
                    <a
                      href={withBase(track.catalog_href)}
                      class="rounded-full bg-off-black text-white hover:bg-black active:scale-[0.98] px-6 py-3 min-h-[44px] inline-flex items-center text-xs font-mono uppercase tracking-wider font-medium transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-off-black focus-visible:ring-offset-2 focus-visible:ring-offset-periwinkle-mist"
                    >
                      Abrir catálogo da trilha
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" aria-label="Trilhas planejadas">
          {plannedTracks.map((track) => (
            <article class="rounded-card border border-ash bg-white/60 p-8 flex flex-col justify-between">
              <div>
                <span class="rounded-full border border-ash bg-parchment px-3 py-0.5 text-xs font-mono uppercase tracking-wider text-graphite font-medium">
                  Planejada, sem catálogo
                </span>
                <h3 class="mt-4 mb-3">{track.title}</h3>
                <p class="font-sans text-sm md:text-base text-graphite leading-relaxed [text-wrap:pretty]">
                  {track.description}
                </p>
              </div>
              <p class="mt-8 pt-4 border-t border-ash/40 font-mono text-xs text-smoke">
                Ainda sem páginas publicadas neste percurso.
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section aria-labelledby="fontes-titulo" class="rounded-card border border-ash bg-white p-8 md:p-12 shadow-sm">
      <span class="font-mono text-xs uppercase tracking-widest text-smoke">Fontes do piloto</span>
      <h2 id="fontes-titulo" class="mt-1 border-0 pb-0">De onde vem cada módulo</h2>
      <p class="max-w-[70ch]">
        Cada módulo do roteiro piloto tem uma fonte principal que dita a progressão
        e fontes de apoio pontuais. Os links abaixo apontam para as páginas públicas oficiais das obras.
      </p>
      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-ash bg-parchment p-5">
          <h3 class="mt-0 text-lg">Fontes principais</h3>
          <ul class="my-3 space-y-3 pl-0 list-none">
            {pilotSources.map((s) => (
              <li class="font-sans text-sm text-graphite leading-relaxed">
                {s.url ? (
                  <a href={s.url} class="font-medium text-lake-blue hover:underline">{s.citation}</a>
                ) : (
                  <span class="font-medium text-off-black">{s.citation}</span>
                )}
                <span class="block font-mono text-xs text-smoke mt-1">Usada em: {(s.used_by || []).join(', ')}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-ash bg-parchment p-5">
          <h3 class="mt-0 text-lg">Apoio pontual</h3>
          <ul class="my-3 space-y-3 pl-0 list-none">
            {supportSources.map((s) => (
              <li class="font-sans text-sm text-graphite leading-relaxed">
                {s.url ? (
                  <a href={s.url} class="font-medium text-lake-blue hover:underline">{s.citation}</a>
                ) : (
                  <span class="font-medium text-off-black">{s.citation}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="font-mono text-xs text-smoke">
        Módulo 00: fonte principal {getPrimarySourceForModule(hardwareModules[0].slug)?.id}. Módulo 01: fonte principal {getPrimarySourceForModule(hardwareModules[1].slug)?.id}.
      </p>
    </section>

    <section aria-labelledby="exploracao-titulo" class="space-y-6">
      <div class="text-center max-w-3xl mx-auto">
        <span class="font-mono text-xs uppercase tracking-widest text-graphite">Exploração opcional</span>
        <h2 id="exploracao-titulo" class="border-0 pb-0">A máquina por fora, antes de abrir o capô</h2>
        <p>
          Um modelo 3D da bancada para passear com os olhos. Não faz parte do roteiro:
          o estudo começa no Módulo 00, com ou sem esta visita.
        </p>
      </div>
      <div class="min-h-[540px]">
        <RetroComputer3D client:visible={{ rootMargin: '200px' }} />
      </div>
    </section>

    <section class="rounded-card border border-ash bg-white/50 p-8 md:p-12 text-center max-w-4xl mx-auto">
      <h2 class="font-serif text-[clamp(1.5rem,3.5vw,2.25rem)] font-normal leading-[1.25] text-off-black tracking-[-0.02em] mb-4 border-0 pb-0 [text-wrap:balance]">
        Comece pelo primeiro interruptor
      </h2>
      <p class="font-sans text-base text-graphite max-w-xl mx-auto mb-8 leading-relaxed [text-wrap:pretty]">
        O Módulo 00 constrói a máquina a partir de chaves e chega ao clock.
        O Módulo 01 coloca números dentro dela. Essa é a ordem do roteiro piloto.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href={withBase(moduleHref(hardwareModules[0]))}
          class="rounded-full bg-off-black text-white hover:bg-black active:scale-[0.98] px-8 py-3.5 min-h-[44px] inline-flex items-center text-xs font-mono uppercase tracking-wider font-medium transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-off-black focus-visible:ring-offset-2 focus-visible:ring-offset-parchment"
        >
          Começar a estudar
        </a>
        <a
          href={withBase(moduleHref(hardwareModules[1]))}
          class="rounded-full bg-white border border-ash hover:border-off-black active:scale-[0.98] text-off-black px-6 py-3.5 min-h-[44px] inline-flex items-center text-xs font-mono uppercase tracking-wider transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-off-black focus-visible:ring-offset-2 focus-visible:ring-offset-parchment"
        >
          Ver o Módulo 01
        </a>
      </div>
    </section>
  </div>
</TrackLayout>
