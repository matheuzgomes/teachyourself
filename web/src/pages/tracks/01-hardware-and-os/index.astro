---
import TrackLayout from '../../../layouts/TrackLayout.astro';
import ContinueReading from '../../../components/ContinueReading.astro';
import { withBase } from '../../../utils/paths';
import {
  getModulesByTrack,
  getPrimarySourceForModule,
  getTrack,
  moduleHref,
} from '../../../data/curriculum';

const trackId = '01-hardware-and-os';
const track = getTrack(trackId);
const modules = getModulesByTrack(trackId);
const pilots = modules.filter((m) => m.study_state === 'pilot');
const resumeModules = modules.map((m) => ({ track: m.track, slug: m.slug, title: m.title }));
---

<TrackLayout
  title={`${track?.title} | Catálogo de Módulos`}
  trackId={trackId}
  trackTitle={track?.title || ''}
>
  <div class="space-y-12 md:space-y-16 py-4">
    <div class="border-b border-ash pb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-ash bg-white/80 px-4 py-1.5 text-xs font-mono uppercase tracking-wider text-graphite mb-5 shadow-sm">
        <span>Trilha 01 : Sistemas de Computação</span>
      </div>
      <h1 class="font-serif text-[clamp(2rem,5vw,3rem)] font-normal tracking-[-0.02em] text-off-black mb-4 leading-[1.2]">
        {track?.title}
      </h1>
      <p class="font-sans text-base text-graphite leading-relaxed max-w-3xl">
        {track?.description} Cada módulo resolve o problema físico ou de isolamento
        deixado pelo anterior. O roteiro piloto cobre {pilots.length} de {modules.length} módulos;
        os demais têm página publicada, mas o conteúdo ainda não passou por revisão neste percurso.
      </p>

      <div class="mt-8 flex flex-wrap gap-3 text-xs font-mono">
        <div class="rounded-full border border-ash bg-white px-4 py-2 flex items-center gap-2 shadow-sm text-graphite">
          <span class="text-smoke">Módulos:</span>
          <span class="font-medium text-off-black">{modules.length} publicados · {pilots.length} no roteiro piloto</span>
        </div>
      </div>
    </div>

    <ContinueReading modules={resumeModules} currentPath={`/tracks/${trackId}`} />

    <div class="space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-smoke">
            Estrutura da Trilha
          </span>
          <h2 class="font-serif text-[clamp(1.5rem,3.5vw,2.25rem)] font-normal text-off-black tracking-[-0.02em] mt-1 border-0 pb-0 leading-[1.25]">
            Escolha um Módulo para Iniciar
          </h2>
        </div>
        <p class="text-xs font-mono text-smoke">
          A ordem do catálogo é a ordem de estudo
        </p>
      </div>

      <div class="space-y-8">
        {modules.map((m) => {
          const isPilot = m.study_state === 'pilot';
          const primary = getPrimarySourceForModule(m.slug);
          return (
            <article
              class="rounded-card border border-ash bg-white p-6 md:p-10 shadow-sm transition-all hover:border-lake-blue/40"
            >
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div class="space-y-2">
                  <div class="flex flex-wrap items-center gap-2.5">
                    {isPilot ? (
                      <span class="rounded-full bg-lake-blue px-3 py-1 font-mono text-xs font-medium text-white">
                        Roteiro piloto
                      </span>
                    ) : (
                      <span class="rounded-full bg-parchment border border-ash px-3 py-1 font-mono text-xs text-smoke">
                        Conteúdo sem revisão
                      </span>
                    )}
                  </div>
                  <h3 class="font-serif text-xl md:text-2xl font-normal text-off-black leading-snug tracking-[-0.02em]">
                    {m.title}
                  </h3>
                </div>

                <a
                  href={withBase(moduleHref(m))}
                  class="rounded-full bg-off-black text-white hover:bg-black active:scale-[0.98] px-6 py-3 min-h-[44px] inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider font-medium transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-off-black focus-visible:ring-offset-2 focus-visible:ring-offset-parchment shrink-0"
                >
                  Abrir Módulo
                </a>
              </div>

              <p class="font-sans text-base text-graphite leading-relaxed mb-6 max-w-[70ch]">
                {m.description}
              </p>

              {isPilot && m.objectives && m.objectives.length > 0 && (
                <div class="rounded-2xl border border-ash bg-parchment p-5 md:p-6">
                  <div class="text-xs font-medium uppercase tracking-wider text-smoke mb-3.5 font-mono">
                    <span>Ao concluir, você explica:</span>
                  </div>
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs list-none pl-0 my-0">
                    {m.objectives.map((o) => (
                      <li class="leading-relaxed text-xs text-graphite">
                        {o.href ? (
                          <a href={withBase(o.href)} class="text-lake-blue hover:underline font-medium">{o.label}</a>
                        ) : (
                          <span>{o.label}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                  {m.prerequisites && m.prerequisites.length > 0 && (
                    <p class="mt-4 mb-0 font-mono text-xs text-smoke">
                      Pré-requisitos: {m.prerequisites.map((p, i) => (
                        <span>
                          {i > 0 && ' · '}
                          {p.href ? <a href={withBase(p.href)} class="text-lake-blue hover:underline">{p.label}</a> : p.label}
                        </span>
                      ))}
                    </p>
                  )}
                  {primary && (
                    <p class="mt-2 mb-0 font-mono text-xs text-smoke">
                      Fonte principal: {primary.url ? (
                        <a href={primary.url} class="text-lake-blue hover:underline">{primary.citation}</a>
                      ) : primary.citation}
                    </p>
                  )}
                </div>
              )}

              {!isPilot && (
                <p class="mt-2 mb-0 font-mono text-xs text-smoke">
                  {m.review_status}
                </p>
              )}

              <div class="mt-6 pt-4 border-t border-ash/60 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-smoke">
                <a
                  href={withBase(moduleHref(m))}
                  class="text-xs font-mono font-medium text-lake-blue hover:underline inline-flex items-center gap-1 min-h-[44px]"
                >
                  Estudar este conteúdo &rarr;
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</TrackLayout>
